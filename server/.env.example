# Copy to .env for local development, and add the same keys in the
# Render dashboard (Environment) for deployment. Never commit real values.

# MongoDB Atlas connection string. Must start with mongodb:// or mongodb+srv://.
# Include the database name in the path (e.g. /setu_rural_care) and keep the
# query string exactly as Atlas gives it (?retryWrites=true&w=majority).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional: only used when MONGODB_URI has no database name in its path.
DB_NAME=setu_rural_care

PORT=5050
NODE_ENV=development

# Auth
JWT_SECRET=change-me
JWT_SECRET_EXPIRY=14d

# Groq (AI features)
GROQ_API_KEY=

# Client origin(s) allowed by CORS
FRONTEND_URL=http://localhost:5173
CORS=http://localhost:5173
